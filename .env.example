# Copy to .env and fill in. NEVER commit .env.

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# DB_ENCRYPTION_KEY: master key material. All working keys (at-rest
# AES-256-GCM data key, JWT signing secret, backup key) are derived from it
# via HKDF. Minimum 16 chars; generate one with: openssl rand -hex 32
# If left unset, the server generates a random key and persists it next to
# the database as securepassx.key (back that file up!).
DB_ENCRYPTION_KEY=""

# DB_PATH: Optional path to the secure sqlite database file (defaults to ./securepassx.db)
DB_PATH="./securepassx.db"
